:root {
    --bg-color: #f4f6f9;
    --card-bg: #ffffff;
    --text-color: #1f2937;
    --border-color: #e5e7eb;
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --correct-bg: #d1fae5;
    --correct-border: #10b981;
    --correct-text: #065f46;
    --wrong-bg: #fee2e2;
    --wrong-border: #ef4444;
    --wrong-text: #991b1b;
}

[data-theme="dark"] {
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --text-color: #f8fafc;
    --border-color: #334155;
    --primary-color: #3b82f6;
    --primary-hover: #60a5fa;
    --correct-bg: #064e3b;
    --correct-border: #10b981;
    --correct-text: #a7f3d0;
    --wrong-bg: #7f1d1d;
    --wrong-border: #ef4444;
    --wrong-text: #fecaca;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    transition: background-color 0.3s, color 0.3s;
}

.container {
    width: 100%;
    max-width: 700px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

h1 {
    font-size: 1.25rem;
    margin: 0;
}

.card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.hidden {
    display: none !important;
}

.mode-buttons {
    display: flex;
    gap: 15px;
    margin-top: 20px;
}

.btn {
    background-color: var(--primary-color);
    color: #ffffff;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
}

.btn:hover {
    background-color: var(--primary-hover);
}

.quiz-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 15px;
    color: var(--primary-color);
}

.options-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
}

.option-btn {
    background-color: transparent;
    border: 2px solid var(--border-color);
    color: var(--text-color);
    padding: 12px 16px;
    border-radius: 8px;
    text-align: left;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s;
}

.option-btn:hover:not([disabled]) {
    border-color: var(--primary-color);
}

.option-btn.correct {
    background-color: var(--correct-bg);
    border-color: var(--correct-border);
    color: var(--correct-text);
}

.option-btn.wrong {
    background-color: var(--wrong-bg);
    border-color: var(--wrong-border);
    color: var(--wrong-text);
}

.feedback-msg {
    margin-top: 15px;
    padding: 10px;
    border-radius: 6px;
    font-weight: bold;
    text-align: center;
}

.feedback-msg.correct-msg {
    background-color: var(--correct-bg);
    color: var(--correct-text);
}

.feedback-msg.wrong-msg {
    background-color: var(--wrong-bg);
    color: var(--wrong-text);
}

#next-btn {
    margin-top: 20px;
    width: 100%;
}
